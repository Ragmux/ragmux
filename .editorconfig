root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js,mjs,cjs,jsx,ts,mts,cts,tsx,css,scss}]
indent_size = 2

[{*.go,Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
