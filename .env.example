# Copy to .env and adjust. DATABASE_URL and SECRET_KEY are required; the rest is optional.

# PostgreSQL (with the pgvector extension). docker-compose.yml builds this from
# POSTGRES_PASSWORD for the bundled "postgres" service; set it explicitly when
# running the binary against your own server.
#DATABASE_URL=postgres://ragmux:ragmux@localhost:5432/ragmux?sslmode=disable

# Password of the bundled Postgres service (docker-compose.yml).
POSTGRES_PASSWORD=ragmux

# 32-byte AES key (64 hex chars) that encrypts provider credentials at rest.
# Generate once and keep it with your database backups:  openssl rand -hex 32
SECRET_KEY=

# Connection pool size.
#DB_MAX_CONNS=10

# First-run admin account (only used when the users table is empty).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Comma-separated origins allowed to call the API from browsers ("*" allows all).
#CORS_ORIGINS=https://app.example.com

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Dashboard session lifetime (Go duration).
#SESSION_TTL=24h

# Per-request upstream timeout for non-streaming calls.
#UPSTREAM_TIMEOUT=5m

# Concurrent document ingestion jobs.
#INGEST_WORKERS=2

# Max document upload size in MB.
#MAX_UPLOAD_MB=50

# Outbound SSRF guard. By default a provider base_url may not resolve to a
# loopback, link-local or private address (10/8, 172.16/12, 192.168/16,
# 169.254/16, fc00::/7, ...), so the gateway cannot be pointed at internal
# services. Local model servers such as Ollama therefore need an entry here:
# a comma-separated list of hostnames that may resolve to private addresses
# (e.g. "host.docker.internal,ollama" for an Ollama on the Docker host or in
# the same Compose network) ...
#PRIVATE_UPSTREAM_ALLOWLIST=host.docker.internal,ollama
# ... or, for a trusted network only, allow every private upstream. This also
# re-enables HTTP_PROXY / HTTPS_PROXY for provider calls.
#ALLOW_PRIVATE_UPSTREAMS=false

# Streaming responses are cut off after this wall time / this many MB.
#STREAM_MAX_DURATION=30m
#STREAM_MAX_BYTES_MB=256

# A document that splits into more chunks than this fails ingestion instead of
# being embedded.
#MAX_CHUNKS_PER_DOCUMENT=20000

# Set to true when served behind HTTPS so the session cookie is marked Secure.
#SECURE_COOKIES=true

# Set to true only behind a reverse proxy that sets X-Forwarded-For / X-Real-IP;
# the client address is then taken from those headers (login limits, audit log).
#TRUST_PROXY_HEADERS=true

# Login protection: failed attempts per minute per IP / per username, and the
# lockout threshold within the lockout window (0 disables a limit).
#LOGIN_RATE_LIMIT_PER_MIN=10
#LOGIN_USER_LIMIT_PER_MIN=5
#LOGIN_LOCKOUT_FAILURES=20
#LOGIN_LOCKOUT_MINUTES=15

# Retention (days) for request logs and the audit log; 0 keeps rows forever.
# Login attempts are kept for 24 hours and expired sessions are removed hourly.
#LOG_RETENTION_DAYS=90
#AUDIT_RETENTION_DAYS=365

# Only used when SECRET_KEY is unset: directory for the generated secret.key
# fallback (development only).
#DATA_DIR=/app/data
